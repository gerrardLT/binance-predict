# LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DECISION_MODEL=deepseek-v4-flash
REVIEW_MODEL=qwen3.8-max

# 数据库（Docker 部署时 compose 读取这三个变量初始化 DB + 构建 DATABASE_URL）
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=binance_predict
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/binance_predict

# Binance 行情
BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443/ws
# REST 公共行情 base（默认主站；api.binance.com 被封锁的网络环境可指向
# 官方公共行情镜像 https://data-api.binance.vision，仅公开行情端点）
# BINANCE_API_BASE=https://api.binance.com
SYMBOL=BTCUSDT
HORIZON=5m
NOISE_THRESHOLD=0.0005
# 原始采样保留时长（小时）；0=永不删除（默认，保留全部历史采样）
SAMPLE_RETENTION_HOURS=0
CONFIDENCE_STRONG=0.75
CONFIDENCE_NORMAL=0.60
CONFIDENCE_WEAK=0.50

# 服务
API_PORT=8000
LOG_LEVEL=INFO

# 安全
# CORS 允许的前端源（逗号分隔），空值默认允许 localhost 开发源
# 生产环境示例: CORS_ALLOWED_ORIGINS=https://predict.example.com,http://your-bt-domain.com
CORS_ALLOWED_ORIGINS=
# API Bearer Token 认证密钥，空值时禁用认证（仅开发环境）
API_AUTH_TOKEN=

# 交易
BINANCE_API_KEY=
BINANCE_API_SECRET=
PREDICTION_TRADE_AMOUNT_USDT=2.0
PREDICTION_WALLET_ADDRESS=
PREDICTION_WALLET_ID=
AGENT_AUTO_TRADE=false

# 多通道实盘（MultiLiveTrader 10 通道，2026-08-24 取代旧单版本报价 edge 实盘）
# 默认全通道 OFF；开启前提：上方 BINANCE_API_KEY/SECRET（预测市场权限）+ 钱包配置就绪
# 每通道默认单笔金额 USDT（硬上限 50）
LIVE_DEFAULT_AMOUNT_USDT=2
# 每通道默认日单量上限（各通道独立计数；运行时可经前端热调 1~500）
LIVE_DEFAULT_MAX_DAILY_ORDERS=100
# 逐通道覆盖（JSON；未知通道名/金额超 50/护栏非法 → 拒绝启动，不靠自律靠拒启）
# 通道名：quote_momentum_v1 / quote_contrarian_v1 / quote_momentum_v2 /
#   quote_contrarian_v2（5m 报价区间）、x4_v1 / x4_v2（5m 影子决策点）、
#   scene_bull_exhaust(S1) / scene_bull_exhaust_confirm(S5) /
#   scene_bear_exhaust(S2) / scene_momentum_fade(S4)（15m 场景）
# 可选键：enabled / amount_usdt / max_daily_orders / max_exec_price（留缺=自动护栏）
# 注意：本变量只是启动基线层；前端/toggle 的运行时设定会持久化到 DB
# （live_channel_overrides 表，优先级更高），重启不丢设定；删表行才回落到本层
# 示例：仅开 quote_contrarian_v1（2U/100 单），x4_v1 开 1U/50 单且护栏收紧到 0.48：
# LIVE_CHANNELS_JSON={"quote_contrarian_v1":{"enabled":true,"amount_usdt":2.0,"max_daily_orders":100},"x4_v1":{"enabled":true,"amount_usdt":1.0,"max_daily_orders":50,"max_exec_price":0.48}}
LIVE_CHANNELS_JSON=

# Agent 运行健康监控 / 告警（邮件为主渠道）
# 告警推送总闸：false 时邮件+webhook 全暂停（健康监控仍跑，仅不主动推送）
AGENT_ALERT_NOTIFY_ENABLED=true
# 告警邮件渠道开关：true 时非 OK 状态且有新告警会发邮件
AGENT_ALERT_EMAIL_ENABLED=false
# 信号邮件推送（所有信号族：场景/x4/quote_edge；SMTP 通道复用下方配置）：
# 与告警开关解耦——暂停告警不影响信号邮件；全局日上限防轰炸
SIGNAL_PUSH_EMAIL_ENABLED=true
SIGNAL_PUSH_MAX_DAILY_EMAILS=800
# SMTP 服务器（587=STARTTLS；465 SSL 需将 USE_TLS 置 false 并自行适配）
AGENT_ALERT_SMTP_HOST=
AGENT_ALERT_SMTP_PORT=587
# 登录凭据（多数邮箱用「授权码」而非登录密码）
AGENT_ALERT_SMTP_USER=
AGENT_ALERT_SMTP_PASSWORD=
AGENT_ALERT_SMTP_USE_TLS=true
# 发件人（留空回退到 SMTP_USER）与收件人（逗号分隔，可多个）
AGENT_ALERT_EMAIL_FROM=
AGENT_ALERT_EMAIL_TO=
# 同一告警 code 的去重抑制窗口（秒），默认 900=15 分钟
AGENT_ALERT_SUPPRESS_SECONDS=900
# 可选备用渠道：通用 JSON webhook（留空禁用）
AGENT_ALERT_WEBHOOK_URL=
# 健康快照保留天数（超期自动清理）
AGENT_HEALTH_SNAPSHOT_RETENTION_DAYS=7
